{
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/node-forge": "^1.3.14",
    "aws-sdk-client-mock": "^4.1.0",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.0",
    "faker-js": "^1.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "name": "teste",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "ts:build": "tsc",
    "ts:build:watch": "tsc --watch",
    "ts:check": "tsc --noEmit",
    "start:local": "tsc --watch &> /dev/null && node --watch --env-file=.env dist/src/shared/main/app.js",
    "start:app": "node --env-file=.env dist/src/app.js",
    "server:dev": "NODE_ENV=local node --watch-path=./app --import tsx app/index.ts",
    "test": "jest --passWithNoTests --silent --noStackTrace --runInBand",
    "test:verbose": "jest --passWithNoTests --runInBand",
    "test:unit": "npm test -- --watch -c jestUnit.config.js",
    "test:integration": "npm test -- --watch -c jestIntegration.config.js",
    "test:ci": "npm test -- --coverage",
    "test:staged": "npm test -- --findRelatedTests",
    "test:file": "jest --runTestsByPath",
    "test:clearCache": "jest --clearCache"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1037.0",
    "express": "~5.2.1",
    "libxmljs2": "^0.37.0",
    "node-forge": "^1.4.0",
    "redis": "^5.12.1",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  }
}
